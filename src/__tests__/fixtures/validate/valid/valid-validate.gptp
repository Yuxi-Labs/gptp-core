{
  "$doctype": "gptp",
  "schemaVersion": "1.2.0",
  "promptVersion": "1.0.0",
  "title": "Validate Prompt Success Case",
  "description": "This prompt is fully schema-valid and should pass validation.",
  "system": "You are a helpful assistant.",
  "messages": [
    { "role": "user", "content": "Hello assistant!" }
  ],
  "variables": {
    "username": {
      "type": "string",
      "description": "The user's name",
      "example": "Alice"
    }
  },
  "metadata": {
    "tags": ["test", "valid"],
    "created_by": "tester",
    "created_at": "2024-06-01T12:00:00Z",
    "model_compatibility": ["gpt-4", "gpt-3.5"]
  },
  "rendering": {
    "style": "chat",
    "instructions_position": "top"
  },
  "params": {
    "model": "gpt-4",
    "temperature": 0.7,
    "top_p": 0.9,
    "max_tokens": 512,
    "stop": ["\n"]
  },
  "output_format": "json",
  "output_schema": {
    "type": "object",
    "properties": {
      "answer": { "type": "string" }
    },
    "required": ["answer"]
  },
  "secrets": ["API_KEY"],
  "tools": [
    {
      "name": "fetchWeather",
      "description": "Fetches weather for a given location",
      "parameters_schema": {
        "type": "object",
        "properties": {
          "location": { "type": "string" }
        },
        "required": ["location"]
      }
    }
  ],
  "vision": {
    "allow_images": true,
    "inputs": [
      {
        "name": "receipt",
        "media_type": "image/png",
        "description": "An uploaded receipt"
      }
    ]
  },
  "tests": [
    {
      "name": "Basic Input",
      "input": { "username": "Alice" },
      "expect_contains": ["Hello"]
    }
  ]
}
