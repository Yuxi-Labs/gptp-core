{
  "$doctype": "INVALID",  // should fail pattern
  "schemaVersion": "1.0.0",  // wrong version (should be 1.2.0)
  "promptVersion": "banana",  // fails semver pattern
  "description": "",  // too short
  "messages": [
    { "role": "alien", "content": "" }  // role not allowed, content too short
  ],
  "variables": {
    "user": {
      "description": "no type defined!"  // missing required "type"
    }
  },
  "params": {
    "temperature": 5  // out of range (>2)
  },
  "assets": [
    {
      "media_type": "image/png"  // missing required "path"
    }
  ],
  "tools": [
    {
      "description": "missing name field",  // missing "name"
      "parameters_schema": {}
    }
  ],
  "vision": {
    "allow_images": "yes",  // should be boolean
    "inputs": [
      {
        "name": "weirdInput"
        // missing media_type
      }
    ]
  }
}
