{
  "$doctype": "gptp",
  "schemaVersion": "1.2.0",
  "promptVersion": "1.0.0",
  "title": "Init Test",
  "description": "From CLI",
  "messages": [
    {
      "role": "user",
      "content": "Hello {{name}}!"
    }
  ],
  "variables": {
    "name": {
      "type": "string",
      "required": true,
      "description": "The name of the user",
      "example": "Alice"
    }
  },
  "params": {
    "model": "gpt-4",
    "temperature": 0.7
  },
  "output_format": "plain-text"
}