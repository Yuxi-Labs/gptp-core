{
  "$doctype": "gptp",
  "schemaVersion": "1.2.0",
  "promptVersion": "1.0.0",
  "title": "hello-world",
  "description": "A minimal GPTP file to verify schema and core functionality.",
  "system": "You are a friendly assistant.",
  "messages": [
    {
      "role": "user",
      "content": "Hello {{user_name}}!"
    }
  ],
  "variables": {
    "user_names": {
      "type": "string",
      "description": "The name of the user",
      "example": "Alice",
      "required": true
    }
  },
  "params": {
    "model": "gpt-4",
    "temperature": 0.2
  },
  "metadata": {
    "target": "openai"
  },
  "output_format": "plain-text",
  "output_schema": {
    "type": "string"
  },
  "tests": [
    {
      "name": "hello-bob",
      "input": {
        "user_name": "Bob"
      },
      "expect_exact": "Hello Bob!"
    }
  ]
}
