{
  "name": "@yuxi-labs/gptp-core",
  "version": "0.0.1",
  "description": "Core validation, formatting and execution logic for the GPTP file format.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rimraf dist",
    "prepare": "npm run clean && npm run build",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write ."
  },
  "keywords": [
    "gptp",
    "prompt",
    "file-format",
    "cli",
    "vscode-extension"
  ],
  "author": "William Sawyerr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yuxi-Labs/gptp-core"
  },
  "bugs": {
    "url": "https://github.com/Yuxi-Labs/gptp-core/issues"
  },
  "homepage": "https://github.com/Yuxi-Labs/gptp-core",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.10",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1"
  }
}
